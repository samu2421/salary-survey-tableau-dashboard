                                <encoding attr='space' class='0' field='[federated.17ybfz006q8ie418u3koh10mw5vd].[Longitude (generated)]' field-type='quantitative' max='-7102239.4105411898' min='-18131049.142124377' projection='EPSG:3857' range-type='fixed' scope='cols' type='space' />
                              </style-rule>
                            </style>
                          </worksheet>
                          <worksheet name='State-wise annual Salary by Industry'>
                            <filter class='categorical' column='[federated.17ybfz006q8ie418u3koh10mw5vd].[Action (CITY,INDUSTRY)]'>
                              <groupfilter function='crossjoin' user:ui-enumeration='all' user:ui-marker='enumerate'>
                                <groupfilter function='level-members' level='[CITY]' />
                                <groupfilter function='level-members' level='[INDUSTRY]' />
                              </groupfilter>
                            </filter>
                          </worksheet>
                        </capturedDeltas>
                      </story-point>
                      <story-point captured-sheet='' id='9' />
