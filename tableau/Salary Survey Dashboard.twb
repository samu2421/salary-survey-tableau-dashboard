          <datasource-dependencies datasource='federated.17ybfz006q8ie418u3koh10mw5vd'>
            <column caption='Annual Salary' datatype='integer' name='[ANNUAL_SALARY]' role='measure' type='quantitative' />
            <column caption='Record Count' datatype='integer' name='[Calculation_3529977695810256897]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNT(1)' />
            </column>
            <column caption='Industry' datatype='string' name='[INDUSTRY]' role='dimension' type='nominal' />
            <column caption='Us States' datatype='string' name='[US_STATES]' role='dimension' semantic-role='[State].[Name]' type='nominal' />
            <column-instance column='[ANNUAL_SALARY]' derivation='Median' name='[med:ANNUAL_SALARY:qk]' pivot='key' type='quantitative' />
            <column-instance column='[INDUSTRY]' derivation='None' name='[none:INDUSTRY:nk]' pivot='key' type='nominal' />
            <column-instance column='[US_STATES]' derivation='None' name='[none:US_STATES:nk]' pivot='key' type='nominal' />
