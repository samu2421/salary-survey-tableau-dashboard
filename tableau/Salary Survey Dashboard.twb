              </zone-style>
            </zone>
            <zone h='95750' id='9' param='vert' removable='false' type-v2='layout-flow' w='98666' x='667' y='3250'>
              <zone h='95750' id='1' param='vert' removable='false' type-v2='layout-flow' w='98666' x='667' y='3250'>
                <zone fixed-size='90' h='11250' id='4' is-fixed='true' paired-zone-id='5' removable='false' type-v2='flipboard-nav' w='98666' x='667' y='3250' />
                <zone h='84500' id='5' paired-zone-id='4' removable='false' type-v2='flipboard' w='98666' x='667' y='14500'>
                  <flipboard active-id='9' nav-type='caption' show-nav-arrows='true'>
                    <story-points>
                      <story-point caption='Median salaries are highest in California ($101,050), Washington ($91,100), New York and DC ($90,000 each). Among states with at least 100 responses, the lowest are Oklahoma ($54,040) and South Carolina ($57,000).' captured-sheet='Salary Distribution based on Various Factors' id='4'>
                        <capturedDeltas>
                          <worksheet name='Annual Salary Distribution by Field_Experience'>
                            <filter class='categorical' column='[federated.17ybfz006q8ie418u3koh10mw5vd].[Action (COUNTRY,INDUSTRY)]'>
                              <groupfilter function='crossjoin' user:ui-enumeration='all' user:ui-marker='enumerate'>
                                <groupfilter function='level-members' level='[COUNTRY]' />
                                <groupfilter function='level-members' level='[INDUSTRY]' />
                              </groupfilter>
                            </filter>
                            <filter class='categorical' column='[federated.17ybfz006q8ie418u3koh10mw5vd].[Action (COUNTRY,INDUSTRY,JOB_TITLE)]'>
                              <groupfilter function='crossjoin' user:ui-enumeration='all' user:ui-marker='enumerate'>
                                <groupfilter function='level-members' level='[COUNTRY]' />
                                <groupfilter function='level-members' level='[INDUSTRY]' />
                                <groupfilter function='level-members' level='[JOB_TITLE]' />
                              </groupfilter>
                            </filter>
                          </worksheet>
                          <worksheet name='Annual Salary Distribution by Industry and Job Title'>
                            <filter class='categorical' column='[federated.17ybfz006q8ie418u3koh10mw5vd].[Action (COUNTRY,INDUSTRY)]'>
                              <groupfilter function='crossjoin' user:ui-enumeration='all' user:ui-marker='enumerate'>
                                <groupfilter function='level-members' level='[COUNTRY]' />
                                <groupfilter function='level-members' level='[INDUSTRY]' />
                              </groupfilter>
                            </filter>
                            <filter class='categorical' column='[federated.17ybfz006q8ie418u3koh10mw5vd].[none:INDUSTRY:nk]'>
                              <groupfilter function='level-members' level='[none:INDUSTRY:nk]' user:ui-enumeration='all' user:ui-marker='enumerate' />
                            </filter>
                            <shelf-sort-deltas>
                              <shelf-sorts>
                                <shelf-sort-v2 dimension-to-sort='[federated.17ybfz006q8ie418u3koh10mw5vd].[none:INDUSTRY:nk]' direction='DESC' is-on-innermost-dimension='true' measure-to-sort-by='[federated.17ybfz006q8ie418u3koh10mw5vd].[avg:ANNUAL_SALARY:qk]' shelf='columns' />
                              </shelf-sorts>
                            </shelf-sort-deltas>
                          </worksheet>
                          <worksheet name='Bonus_or_overtime vs Industry in diff Countries'>
                            <filter class='categorical' column='[federated.17ybfz006q8ie418u3koh10mw5vd].[Action (COUNTRY,INDUSTRY,JOB_TITLE)]'>
                              <groupfilter function='crossjoin' user:ui-enumeration='all' user:ui-marker='enumerate'>
                                <groupfilter function='level-members' level='[COUNTRY]' />
                                <groupfilter function='level-members' level='[INDUSTRY]' />
                                <groupfilter function='level-members' level='[JOB_TITLE]' />
                              </groupfilter>
                            </filter>
                            <filter class='categorical' column='[federated.17ybfz006q8ie418u3koh10mw5vd].[none:INDUSTRY:nk]'>
                              <groupfilter function='level-members' level='[none:INDUSTRY:nk]' user:ui-enumeration='all' user:ui-marker='enumerate' />
                            </filter>
                            <style delta-type='added'>
                              <style-rule element='axis'>
                                <encoding attr='space' class='0' field='[federated.17ybfz006q8ie418u3koh10mw5vd].[max:BONUS_OR_OVERTIME:qk]' field-type='quantitative' scope='cols' type='space' />
                              </style-rule>
                            </style>
                            <shelf-sort-deltas>
                              <shelf-sorts>
                                <shelf-sort-v2 dimension-to-sort='[federated.17ybfz006q8ie418u3koh10mw5vd].[none:INDUSTRY:nk]' direction='DESC' is-on-innermost-dimension='true' measure-to-sort-by='[federated.17ybfz006q8ie418u3koh10mw5vd].[max:BONUS_OR_OVERTIME:qk]' shelf='rows' />
                              </shelf-sorts>
                            </shelf-sort-deltas>
                          </worksheet>
                        </capturedDeltas>
                      </story-point>
                      <story-point caption='Median salary rises with education, from $56,000 (high school) to $97,000 (PhD) and $120,000 (professional degrees such as MD or JD), and with experience at every education level. Note: 78% of respondents are women, so the industry chart shows the survey’s audience, not the US workforce.' captured-sheet='Salary Breakdown by Education, Experience &amp; Gender' id='7'>
                        <capturedDeltas>
                          <worksheet name='Demographic Breakdown (Gender) in Industries'>
                            <filter class='categorical' column='[federated.17ybfz006q8ie418u3koh10mw5vd].[Action (EDUCATION,GENDER,TOTAL_EXPERIENCE)]'>
                              <groupfilter function='crossjoin' user:ui-enumeration='all' user:ui-marker='enumerate'>
                                <groupfilter function='level-members' level='[EDUCATION]' />
                                <groupfilter function='level-members' level='[GENDER]' />
                                <groupfilter function='level-members' level='[TOTAL_EXPERIENCE]' />
                              </groupfilter>
                            </filter>
                            <filter class='categorical' column='[federated.17ybfz006q8ie418u3koh10mw5vd].[none:GENDER:nk]'>
                              <groupfilter function='level-members' level='[none:GENDER:nk]' user:ui-enumeration='all' user:ui-marker='enumerate' />
                            </filter>
                          </worksheet>
                          <worksheet name='Experience vs. Salary by Education Level'>
                            <filter class='categorical' column='[federated.17ybfz006q8ie418u3koh10mw5vd].[Action (GENDER,INDUSTRY)]'>
                              <groupfilter function='crossjoin' user:ui-enumeration='all' user:ui-marker='enumerate'>
                                <groupfilter function='level-members' level='[GENDER]' />
                                <groupfilter function='level-members' level='[INDUSTRY]' />
                              </groupfilter>
                            </filter>
                            <current-page>
                              <multibucket>
                                <bucket>&quot;Man&quot;</bucket>
                              </multibucket>
                            </current-page>
                          </worksheet>
                        </capturedDeltas>
                      </story-point>
                      <story-point caption='Median salary roughly doubles from $56,000 (1 year or less in the field) to $108,000 (41+ years). 47% of respondents receive a bonus or overtime pay: 76% in insurance and 73% in sales, but only 14% in higher education.' captured-sheet='Annual Salary Distribution in USA (By City &amp; State)' id='8'>
                        <capturedDeltas>
                          <worksheet name='City - wise Annual Salary and Job Title Distribution'>
                            <style delta-type='added'>
