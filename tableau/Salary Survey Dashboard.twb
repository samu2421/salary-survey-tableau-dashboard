        </style-rule>
      </style>
      <size maxheight='800' maxwidth='1200' minheight='800' minwidth='1200' preset-index='13' sizing-mode='fixed' />
      <zones>
        <zone h='100000' id='2' type-v2='layout-basic' w='100000' x='0' y='0'>
          <zone h='98000' id='11' param='vert' removable='false' type-v2='layout-flow' w='98666' x='667' y='1000'>
            <zone h='2250' id='12' type-v2='title' w='98666' x='667' y='1000'>
              <zone-style>
